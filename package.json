{
  "name": "drakepg",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "rolldown scripts/sim.ts -p node -f esm -o .sim/sim.mjs && node .sim/sim.mjs",
    "pace": "rolldown scripts/pace.ts -p node -f esm -o .sim/pace.mjs && node .sim/pace.mjs",
    "export-data": "rolldown scripts/export-data.ts -p node -f esm -o .sim/export-data.mjs && node .sim/export-data.mjs",
    "golden": "rolldown scripts/golden.ts -p node -f esm -o .sim/golden.mjs && node .sim/golden.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
